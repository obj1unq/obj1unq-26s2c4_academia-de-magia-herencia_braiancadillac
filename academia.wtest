import academia.*

describe "Tests de academia punto 1"{
    const pelota = new Cosa(marca = cuchuflito, volumen = 3, esElementoMagico = false, esReliquia = false)
    const escoba = new Cosa(marca = acme, volumen = 4, esElementoMagico = true, esReliquia = true)
    const varita = new Cosa(marca = fenix, volumen = 1, esElementoMagico = true, esReliquia = false)
    const pava = new Cosa(marca = acme, volumen = 2, esElementoMagico = false, esReliquia = true)
    const lamparaAladino = new Cosa(marca = fenix, volumen = 3, esElementoMagico = true, esReliquia = true)
    const baul = new Baul(capacidadMaxima = 5) 
    const gabineteMagico = new GabineteMagico(precio = 25)
    const armario = new ArmarioConvencional(capacidadMaxima = 2)
    const academia = new Academia()

    method initialize(){
        baul.agregar(escoba)
        armario.agregar(pelota)
        gabineteMagico.agregar(varita)
        academia.muebles().add(baul)
        academia.muebles().add(gabineteMagico)
        academia.muebles().add(armario)
    }

    test "test 1: Verificar si la varita está guardada en la academia"{
        assert.throwsException({academia.verificarSiEstaGuardada(varita)})
    }
    test "test 1.1: Verificar que la pelota está guardada en la academia"{
        assert.throwsException({academia.verificarSiEstaGuardada(pelota)})
    }
    test "test 1.2: Verificar que la escoba está guardada en la academia"{
        assert.throwsException({academia.verificarSiEstaGuardada(escoba)})
    }
    test "test 1.3: Verificar que la pava NO está guardada en la academia"{
        assert.notThat(academia.estaGuardada(pava))
    }
    test "test 1.4: Verificar que la lámpara NO está guardada en la academia"{
        assert.notThat(academia.estaGuardada(lamparaAladino))
    }

    test "test 2: la escoba está en el baúl, la pelota está en el armario y la varita está en el gabinete mágico"{
        assert.that(baul.cosas().contains(escoba))
        assert.that(armario.cosas().contains(pelota))
        assert.that(gabineteMagico.cosas().contains(varita))
    }

    test "test 3.1: el armario tenga solo 1 de capacidad, entonces ya no se puede guardar porque no entra en ningún mueble"{
        armario.capacidadMaxima(1)
        assert.throwsException({academia.agregar(pava)})
    }
    test "test 3.2: La lámpara también se puede guardar,ya que entra tanto en el baúl como en el gabinete mágico"{
        academia.agregar(lamparaAladino)
        assert.that(academia.estaGuardada(lamparaAladino))
    }
    test "3.3: La pelota, la escoba y la varita no se pueden guardar debido a que ya están guardados"{
        assert.throwsException({academia.agregar(pelota)})
        assert.throwsException({academia.agregar(escoba)})
        assert.throwsException({academia.agregar(varita)})
    }

    test "4: la pava de mate se puede guardar en el armario"{
        assert.that(armario.sePuedeAgregar(pava))
    }

    test "4.1: la lámpara de Aladino entra tanto en el armario como en el gabinete mágico "{
        assert.that(armario.sePuedeAgregar(lamparaAladino))
        assert.that(gabineteMagico.sePuedeAgregar(lamparaAladino))
    }

    test "test 5: Guardar la pava y la lámpara en la academia"{
        academia.agregar(pava)
        academia.agregar(lamparaAladino)
        assert.that(academia.estaGuardada(pava))
        assert.that(academia.estaGuardada(lamparaAladino))
        assert.throwsException({ academia.agregar(escoba) })
        assert.throwsException({ academia.agregar(pava) })
        assert.throwsException({ academia.agregar(varita) })
    }
}


describe "Tests de academia punto 2"{
    const pelota = new Cosa(marca = cuchuflito, volumen = 3, esElementoMagico = false, esReliquia = false)
    const escoba = new Cosa(marca = acme, volumen = 4, esElementoMagico = true, esReliquia = true)
    const varita = new Cosa(marca = fenix, volumen = 1, esElementoMagico = true, esReliquia = false)
    const pava = new Cosa(marca = acme, volumen = 2, esElementoMagico = false, esReliquia = true)
    const lamparaAladino = new Cosa(marca = fenix, volumen = 3, esElementoMagico = true, esReliquia = true)
    const baul = new Baul(capacidadMaxima = 5) 
    const gabineteMagico = new GabineteMagico(precio = 6)
    const armario = new ArmarioConvencional(capacidadMaxima = 2)
    const academia = new Academia()

    method initialize(){
        armario.agregar(pelota)
        armario.agregar(pava)
    
        gabineteMagico.agregar(varita)
        gabineteMagico.agregar(lamparaAladino)

        baul.agregar(escoba)

        academia.muebles().add(armario)
        academia.muebles().add(gabineteMagico)
        academia.muebles().add(baul)
    }

    test "test 2: La utilidad del armario (que tiene la pelota y la pava)"{
        assert.equals(1.1, armario.utilidad())
    }
    test "test 2.2: el conjunto de las cosas menos útiles de los muebles de la academia"{
        const cosasMenosUtiles = #{}  //para testear las cosas menos útiles de cada mueble
        academia.muebles().forEach({ mueble => cosasMenosUtiles.add(mueble.cosaMenosUtil())})
        assert.equals(#{pelota, varita, escoba}, cosasMenosUtiles)
    }
    test "2.3: La marca del menos útil"{
        const cosasMenosUtiles = #{}  //para testear las cosas menos útiles de cada mueble
        academia.muebles().forEach({ mueble => cosasMenosUtiles.add(mueble.cosaMenosUtil())})
        var cosaMenosUtil = cosasMenosUtiles.min({ cosa => cosa.utilidad() })
        assert.equals(cuchuflito, cosaMenosUtil.marca())
    }

    test "2.4: Remover de la academia aquellas cosas menos útiles y que no son mágicas"{
        academia.removerCosasMenosUtiles()
        assert.notThat(academia.estaGuardada(pelota))
    }


}


describe "Academia con 2 muebles"{
    const pelota = new Cosa(marca = cuchuflito, volumen = 3, esElementoMagico = false, esReliquia = false)
    const escoba = new Cosa(marca = acme, volumen = 4, esElementoMagico = true, esReliquia = true)
    const varita = new Cosa(marca = fenix, volumen = 1, esElementoMagico = true, esReliquia = false)
    const pava = new Cosa(marca = acme, volumen = 2, esElementoMagico = false, esReliquia = true)
    const lamparaAladino = new Cosa(marca = fenix, volumen = 3, esElementoMagico = true, esReliquia = true)
    const baul = new Baul(capacidadMaxima = 5) 
    const gabineteMagico = new GabineteMagico(precio = 6)
    const armario = new ArmarioConvencional(capacidadMaxima = 2)
    const academia = new Academia()

    method initialize(){
        armario.agregar(pelota)
        armario.agregar(pava)
    
        gabineteMagico.agregar(varita)
        gabineteMagico.agregar(lamparaAladino)

        baul.agregar(escoba)

        academia.muebles().add(armario)
        
        academia.muebles().add(baul)
    }
    test "test último: "{
        assert.throwsException({ academia.removerCosasMenosUtiles() })
    }
}